# sig-bot secrets TEMPLATE — copy to `.env` (gitignored) and fill real values.
# NEVER put real keys in this file; this template is committed. The real `.env` is git-ignored.
# Secrets live ONLY here — NEVER in config/sig.yaml. Code reads them via sig.config.require_secret(NAME),
# which FAILS LOUD if a required key is missing (no silent "" default).

# ── SIG Predictions Cup API keys (per-key rate limits: 100 reads/min, 30 writes/min) ──
# Three keys (schema §4 n_keys 1→3): read (loops/snapshot), write (OMS/broker), fast (arb lane).
# REQUIRED to trade LIVE: SIG_API_KEY_READ + SIG_API_KEY_WRITE (load_config fails loud if absent in LIVE).
# SIM mode needs none (the SimulatedBroker places no real order).
SIG_API_KEY_READ=sk_...redacted      # REQUIRED (LIVE) — read client + realtime token
SIG_API_KEY_WRITE=sk_...redacted     # REQUIRED (LIVE) — order write path (sig/broker.py)
SIG_API_KEY_FAST=sk_...redacted      # OPTIONAL — dedicated fast/arb lane (overflow key)
SIG_BASE_URL=https://www.thesuper.market/api/v1   # non-secret default; override only if needed

# ── Alerting (ported dead-man / paging; ALL OPTIONAL — each notifier self-disables if unset) ──
NTFY_TOPIC=                          # ntfy.sh topic for push alerts
DISCORD_WEBHOOK_URL=                 # Discord webhook -- sig-bot's PRIMARY operator channel.
                                     #   Discord: Server Settings > Integrations > Webhooks > New,
                                     #   pick the channel, Copy Webhook URL. It is a CREDENTIAL
                                     #   (anyone holding it can post fake alerts) -- never commit it.
ALERT_WEBHOOK_URL=                   # generic alert webhook (infra/control/alerts.py)
ALERT_WEBHOOK_TOKEN=                 # bearer token for the generic webhook, if it needs one
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# ── Control API sidecar (bearer token for /health /status) ──
CONTROL_API_TOKEN=                   # REQUIRED only if the FastAPI monitoring sidecar is run

# ── Test/ops seams (NOT secrets; documented here for completeness) ──
# SIG_DATA_DIR=   # redirects ALL state paths (state.db, backups) to a tmp dir — tests set this; prod leaves it unset
